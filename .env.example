DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# на проде: DJANGO_DEBUG=0, DJANGO_ALLOWED_HOSTS=kokoclub.ru, CSRF_TRUSTED_ORIGINS=https://kokoclub.ru

POSTGRES_DB=koko
POSTGRES_USER=koko
POSTGRES_PASSWORD=koko

# Страница меню клуба в Падаче (бар, заказы, оплата). Пока — демо; пусто — пункта «Меню» нет.
MENU_URL=https://demo.padacha.ru/

# Клубный день начинается в этот час: кто не приложил карту на выходе,
# к утру перестаёт числиться «в клубе».
CLUB_DAY_START_HOUR=6

# Интернет-эквайринг Т-Банка. Значения заполняются только на стороне сервера.
TBANK_TERMINAL=
TBANK_PASSWORD=
TBANK_API_TOKEN=
TBANK_PUBLIC_ORIGIN=
TBANK_RETURN_PATH=/#cabinet
TBANK_TEST=1
# Для терминала с онлайн-кассой задать оба параметра согласно настройкам кассы.
TBANK_TAXATION=
TBANK_ITEM_TAX=
