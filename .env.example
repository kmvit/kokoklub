DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# на проде: DJANGO_DEBUG=0, DJANGO_ALLOWED_HOSTS=kokoclub.ru, CSRF_TRUSTED_ORIGINS=https://kokoclub.ru

POSTGRES_DB=koko
POSTGRES_USER=koko
POSTGRES_PASSWORD=koko

# console — код входа пишется в лог бэкенда; smsru — настоящие SMS через sms.ru
SMS_BACKEND=console
SMSRU_API_ID=
SMS_SENDER=

# Страница меню клуба в Падаче (бар, заказы, оплата). Пусто — пункта «Меню» нет.
MENU_URL=

# Клубный день начинается в этот час: кто не приложил карту на выходе,
# к утру перестаёт числиться «в клубе».
CLUB_DAY_START_HOUR=6
